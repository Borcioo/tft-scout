{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "defaultBranch": "main"
    },
    "files": {
        "includes": [
            "**",
            "!public",
            "!storage",
            "!bootstrap",
            "!vendor",
            "!**/*.blade.php",
            "!resources/js/components/ui",
            "!composer.lock",
            "!pnpm-lock.yaml"
        ]
    },
    "formatter": {
        "enabled": true,
        "useEditorconfig": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 80
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        },
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "enabled": true,
        "domains": {
            "react": "recommended",
            "test": "recommended"
        },
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnusedImports": "error",
                "noUnusedVariables": {
                    "level": "error",
                    "options": { "ignoreRestSiblings": true }
                }
            },
            "style": {
                "useBlockStatements": "error",
                "useImportType": {
                    "level": "error",
                    "options": { "style": "separatedType" }
                },
                "useConsistentArrayType": {
                    "level": "error",
                    "options": { "syntax": "shorthand" }
                },
                "noNonNullAssertion": "warn"
            },
            "suspicious": {
                "noExplicitAny": "off",
                "noConsole": {
                    "level": "warn",
                    "options": { "allow": ["warn", "error"] }
                }
            },
            "nursery": {
                "useSortedClasses": {
                    "level": "warn",
                    "fix": "safe",
                    "options": { "functions": ["clsx", "cn", "cva"] }
                }
            }
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["resources/js/workers/scout/**"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": "off"
                    }
                }
            }
        },
        {
            "includes": ["scripts/**", "*.config.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        }
    ]
}
